{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Repositorium Silo Container",
  "description": "Fibonacci-organized academic knowledge silo for the Imaginarium",
  "type": "object",
  "required": [
    "silo_id",
    "silo_name",
    "source_node",
    "fibonacci_level",
    "geometry",
    "ontology"
  ],
  "properties": {
    "silo_id": {
      "type": "string",
      "pattern": "^SILO-[A-Z]{3}-[0-9]{4}$",
      "description": "Unique identifier: SILO-ELP-0001 (Earth Lights Phenomena)"
    },
    "silo_name": {
      "type": "string",
      "description": "Human-readable academic discipline name"
    },
    "source_node": {
      "type": "string",
      "const": "JOHN_CARTER_ROOT",
      "description": "Absolute root \u2014 you are the genesis node"
    },
    "fibonacci_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 13,
      "description": "1,1,2,3,5,8... determines spiral distance from center and branching factor"
    },
    "geometry": {
      "type": "object",
      "properties": {
        "spiral_angle_degrees": {
          "type": "number"
        },
        "golden_ratio_position": {
          "type": "number"
        },
        "polar_coordinates": {
          "type": "object",
          "properties": {
            "r": {
              "type": "number"
            },
            "theta": {
              "type": "number"
            }
          }
        },
        "containment_bounds": {
          "type": "object",
          "properties": {
            "max_sub_nodes": {
              "type": "integer"
            },
            "max_depth": {
              "type": "integer"
            }
          }
        }
      }
    },
    "ontology": {
      "type": "object",
      "description": "What this silo IS \u2014 definitional boundaries",
      "properties": {
        "domain_definition": {
          "type": "string"
        },
        "scope_boundary": {
          "type": "string"
        },
        "disciplinary_parents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "established_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "corpus": {
      "type": "object",
      "description": "What they've learned \u2014 consolidated knowledge base",
      "properties": {
        "core_theories": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "verified_findings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "historical_landmarks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "bibliography": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "research_inventory": {
      "type": "object",
      "description": "What they've managed to research and identify",
      "properties": {
        "completed_studies": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "datasets_catalogued": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "instruments_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "methodologies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "gap_analysis": {
      "type": "object",
      "description": "Where the holes are",
      "properties": {
        "research_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "gap_id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "major",
                  "minor",
                  "exploratory"
                ]
              },
              "blocking_dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "estimated_closure_complexity": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "unknown"
                ]
              }
            }
          }
        },
        "rd_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "gap_id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "required_technology": {
                "type": "string"
              },
              "required_funding_estimate": {
                "type": "string"
              },
              "timeline_to_close": {
                "type": "string"
              }
            }
          }
        },
        "closure_pathways": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pathway_id": {
                "type": "string"
              },
              "target_gap_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "required_resources": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "responsible_entity": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "human_capital": {
      "type": "object",
      "description": "Who is doing the work",
      "properties": {
        "profound_thinkers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "institution": {
                "type": "string"
              },
              "contribution_type": {
                "type": "string"
              },
              "contact_vector": {
                "type": "string"
              },
              "brilliance_rating": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
            }
          }
        },
        "groundwork_operatives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "current_project": {
                "type": "string"
              },
              "needs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "needed_expertise": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "line_items": {
      "type": "array",
      "description": "Individual research line items that need execution",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "active",
              "stalled",
              "completed",
              "archived"
            ]
          },
          "parent_silo": {
            "type": "string"
          },
          "data_requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_target": {
            "type": "string"
          },
          "submissions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "contributor": {
                  "type": "string"
                },
                "submission_date": {
                  "type": "string",
                  "format": "date"
                },
                "data_type": {
                  "type": "string",
                  "enum": [
                    "raw_data",
                    "processed_dataset",
                    "analysis",
                    "paper",
                    "instrument_reading",
                    "simulation"
                  ]
                },
                "file_uris": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "lineage_proof": {
                  "type": "string"
                },
                "validation_status": {
                  "type": "string",
                  "enum": [
                    "unverified",
                    "peer_reviewed",
                    "replicated",
                    "disputed"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "last_updated": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "string"
        },
        "curator": {
          "type": "string"
        },
        "access_level": {
          "type": "string",
          "enum": [
            "public",
            "restricted",
            "private",
            "invitation_only"
          ]
        }
      }
    }
  }
}